# Public project configuration. Safe to expose; access is still protected by login.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-project-key"

# Server-only key. Never add this to frontend code or commit a real value.
SUPABASE_SECRET_KEY="sb_secret_your-server-key"

# Use the exact email of the auditor account you create in Supabase Auth.
AUDITLY_OWNER_EMAIL="you@example.com"

# Create this as a private bucket in Supabase Storage.
AUDITLY_STORAGE_BUCKET="auditly-private"
